# Copy this file to `.env` and adjust for your local setup.
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost
# (use your machine's LAN IP instead if testing on a physical device).
API_BASE_URL=http://10.0.2.2:8000/api/v1

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client IDs → the "Web application" client (not the Android one). Required
# for Google Sign-In to obtain a verifiable ID token. Leave blank to disable
# Google Sign-In in dev builds.
GOOGLE_SERVER_CLIENT_ID=

# International format, no leading `+` (wa.me's expected format) — where
# manual-payment "message admin" buttons send proof-of-payment screenshots.
SUPPORT_WHATSAPP_NUMBER=2340000000000
